rules_version = '2';

// Jamfam Firestore security rules.
// Deploy: `npx firebase-tools deploy --only firestore:rules`
// (or paste into Firebase console → Firestore → Rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public artist profiles; each person can only write their own.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid);
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.ownerId);
      allow update: if isMe(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isMe(resource.data.ownerId);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.authorId);
      allow update: if isMe(resource.data.authorId)
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isMe(resource.data.authorId);
    }

    // Only the sender and recipient can see a request. The sender creates it
    // as `pending`; only the recipient can accept/decline it.
    match /connectionRequests/{requestId} {
      allow read: if isMe(resource.data.fromUserId) || isMe(resource.data.toUserId);
      allow create: if isMe(request.resource.data.fromUserId)
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isMe(resource.data.toUserId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    // Conversation ids are the two participant uids sorted and joined by `_`.
    match /conversations/{conversationId} {
      function validParticipants(data) {
        return data.participantIds.size() == 2
          && request.auth.uid in data.participantIds
          && conversationId == data.participantIds[0] + '_' + data.participantIds[1];
      }

      // getAfter because accepting a request and creating its conversation
      // happen in one batch.
      function connectedByAcceptedRequest(data) {
        let connection = getAfter(/databases/$(database)/documents/connectionRequests/$(data.requestId)).data;
        return connection.status == 'accepted'
          && [connection.fromUserId, connection.toUserId].toSet() == data.participantIds.toSet();
      }

      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && validParticipants(request.resource.data)
        && connectedByAcceptedRequest(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      // Membership comes from the id, which saves a document read per message
      // and lets the chat screen listen before the conversation exists. Only
      // connected pairs have a conversation, so sending requires one.
      // Messages are immutable.
      match /messages/{messageId} {
        function isParticipant() {
          return signedIn() && request.auth.uid in conversationId.split('_');
        }

        allow read: if isParticipant();
        allow create: if isParticipant()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is string;
        allow update, delete: if false;
      }
    }
  }
}
