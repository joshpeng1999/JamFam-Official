rules_version = '2';

// Jamfam Storage security rules.
// Deploy: `npx firebase-tools deploy --only storage`
// (or paste into Firebase console → Storage → Rules).
service firebase.storage {
  match /b/{bucket}/o {
    // Post media and covers: users/{uid}/posts/{postId}/{media|cover}.{ext}
    // Any signed-in user can view; only the owner can upload, capped at
    // 100 MB (keep in sync with MAX_UPLOAD_BYTES in src/services/mediaUpload.ts).
    match /users/{uid}/posts/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('(video|audio|image)/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
